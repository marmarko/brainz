# Phase 0 probe credentials.
#
# Copy to `.env` (gitignored) and fill in. NEVER commit the filled copy, and
# don't paste these values into a chat transcript — a transcript is another
# place a live credential can end up.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Each probe's README documents its own variables in more detail. Everything
# here is throwaway by design: every account below should be one you are happy
# to delete afterwards.

# ═══════════════════════════════════════════════════════════════════════════
# 1. container-tcp — settles Assumption 4 (raw outbound TCP from a Container)
# ═══════════════════════════════════════════════════════════════════════════
# Needs: Cloudflare account on a WORKERS PAID plan (~$5/mo — Containers are not
# on the free plan), and a throwaway Neon project.

# Cloudflare API token for `wrangler deploy`. Create at
# dash.cloudflare.com → My Profile → API Tokens → "Edit Cloudflare Workers".
CLOUDFLARE_API_TOKEN=

# The DIRECT Neon connection string — the one WITHOUT `-pooler` in the host.
# A throwaway project: the probe connects, runs SELECT 1, sets a GUC and reads
# it back. Point this at nothing that matters.
PROBE_DATABASE_URL=

# You invent this one. Any random string; it is what stops a stranger from
# hitting the deployed probe endpoint.
#   openssl rand -hex 24
PROBE_AUTH_TOKEN=

# Set after `wrangler deploy` prints the origin. Not something you obtain.
PROBE_URL=

# ═══════════════════════════════════════════════════════════════════════════
# 2. r2-boundary — settles R9 (bucket-per-tenant vs prefix-scoped credentials)
# ═══════════════════════════════════════════════════════════════════════════
# Needs: the same Cloudflare account with R2 enabled. Does NOT need Workers Paid.
#
# Create ONE R2 API token with "Admin Read & Write":
#   dash.cloudflare.com → R2 → Manage API tokens → Create API token
# That one screen shows the token value, the Access Key ID and the Secret Access
# Key — which are three of the four variables below. Admin scope is required
# because the probe creates and deletes buckets (and deletes every one it makes).

# R2 dashboard, right-hand sidebar.
R2_ACCOUNT_ID=

# The token VALUE (used as `Authorization: Bearer`).
R2_API_TOKEN=

# The same token's Access Key ID.
R2_ACCESS_KEY_ID=

# The same token's Secret Access Key. If you lost it, Cloudflare documents it as
# the SHA-256 of the token value:
#   printf %s "$R2_API_TOKEN" | shasum -a 256
R2_SECRET_ACCESS_KEY=

# Optional. A BARE HOSTNAME, no scheme — the dashboard shows it with https://
# which you must strip. Defaults to <account>.r2.cloudflarestorage.com.
# R2_S3_ENDPOINT=

# ═══════════════════════════════════════════════════════════════════════════
# 3. scheduled-task — settles Assumption 3 (unattended scheduled invocation)
# ═══════════════════════════════════════════════════════════════════════════
# Needs: somewhere to deploy with a PUBLIC HTTPS origin and a PERSISTENT VOLUME
# (Railway, Fly, a small VPS — anything). A custom connector cannot reach
# localhost, and an ephemeral filesystem wipes the log, which now blocks both
# verdicts rather than silently producing a meaningless one.
#
# Also needs a Claude client that can schedule a task. Read the probe's README
# first: a Desktop-LOCAL schedule cannot reach a positive verdict through any
# instrument — the machine has to be awake to fire it. Cloud-scheduled runs are
# what this can actually settle.

# You invent both. They MUST differ — the MCP token goes into a connector URL
# handed to a third party; the admin token never leaves your hands.
#   openssl rand -hex 24
PROBE_MCP_TOKEN=
PROBE_ADMIN_TOKEN=

# Public HTTPS origin of the deployed probe, e.g. https://brainz-probe.example.com
PROBE_BASE_URL=

# Point at a MOUNTED VOLUME. Durability is not assumed: leave PROBE_LOG_DURABLE
# unset until the path really is durable, and the probe will refuse to return a
# verdict rather than trust a log that may have been wiped under it.
# PROBE_LOG_PATH=/data/probe-log.jsonl
# PROBE_LOG_DURABLE=1
